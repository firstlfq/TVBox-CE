<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginLeft="@dimen/vs_10"
    android:layout_marginRight="@dimen/vs_10"
    android:layout_marginTop="@dimen/vs_5"
    android:layout_marginBottom="@dimen/vs_5"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/button_dialog_main"
    android:paddingLeft="@dimen/vs_15"
    android:paddingRight="@dimen/vs_15">

    <TextView
        android:id="@+id/tvCheck"
        android:layout_width="@dimen/vs_40"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:textSize="@dimen/ts_26"
        android:textColor="@color/color_FFFFFF"
        tools:text="✓" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_12"
        android:paddingLeft="@dimen/vs_4">

        <TextView
            android:id="@+id/tvLineName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            tools:text="🚀1-肥猫" />

        <TextView
            android:id="@+id/tvLineUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_80"
            android:textSize="@dimen/ts_20"
            tools:text="https://example.com/config.json" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCopy"
        android:layout_width="@dimen/vs_60"
        android:layout_height="@dimen/vs_55"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:text="复制"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/shape_user_focus" />

</LinearLayout>
