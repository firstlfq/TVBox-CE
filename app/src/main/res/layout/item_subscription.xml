<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/vs_5"
    android:paddingBottom="@dimen/vs_5"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/ivPushpin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="📌"
        android:textSize="@dimen/ts_22"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:background="@drawable/button_dialog_main"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/vs_10">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            tools:text="订阅: 1" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_80"
            android:textSize="@dimen/ts_20"
            tools:text="https://example.com/config.json" />

    </LinearLayout>

    <ImageView
        android:id="@+id/tvDel"
        android:layout_width="@dimen/vs_50"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/vs_5"
        android:layout_marginLeft="@dimen/vs_5"
        android:background="@drawable/button_dialog_main"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/vs_10"
        android:src="@drawable/icon_delete" />

</LinearLayout>
