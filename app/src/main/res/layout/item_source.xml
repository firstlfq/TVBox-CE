<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/vs_5"
    android:paddingBottom="@dimen/vs_5"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/button_dialog_main">

    <TextView
        android:id="@+id/tvMultiTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="@dimen/ts_22"
        android:paddingLeft="@dimen/vs_10"
        android:paddingRight="@dimen/vs_10"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/vs_10">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            tools:text="多仓: 肥猫源" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_80"
            android:textSize="@dimen/ts_20"
            tools:text="3条线路 · 当前: 🚀1-肥猫" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDel"
        android:layout_width="@dimen/vs_50"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_26"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/button_dialog_main"
        android:visibility="gone" />

</LinearLayout>
